# Supabase — copy these from your Supabase project dashboard
# (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — NOT exposed to the browser (no NEXT_PUBLIC_ prefix).
# Reserved for future admin operations (Slice 2+). Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Sentry error logging.
# DSN from Sentry: Settings → Projects → [project] → Client Keys (DSN).
# MUST be an EU-region project (DSN contains ".de." e.g. ...ingest.de.sentry.io)
# for GDPR. The DSN is safe to expose (NEXT_PUBLIC_); leaving it blank disables
# Sentry entirely (no events sent, no errors). Set it in Vercel for prod.
NEXT_PUBLIC_SENTRY_DSN=

# Optional — only needed to upload source maps during the build so production
# stack traces are readable. Set these as CI/Vercel env vars, not locally.
# Without SENTRY_AUTH_TOKEN, source-map upload is skipped and the build still
# works. Create the token at Sentry → Settings → Auth Tokens.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Amplitude product analytics (opt-in).
# EU-region API key from app.eu.amplitude.com (Settings → Projects → API Key).
# Safe to expose (NEXT_PUBLIC_). Leaving it blank disables analytics entirely —
# no SDK init, no events. Analytics only loads after the user accepts the
# consent banner. Set it in Vercel for prod.
NEXT_PUBLIC_AMPLITUDE_API_KEY=

# In-app bug reports → GitHub issues.
# Fine-grained personal access token scoped to the digirenraz/pogosundet repo
# with ONLY "Issues: Read and write" permission (GitHub → Settings → Developer
# settings → Fine-grained tokens). Server-only secret — NOT exposed to the
# browser (no NEXT_PUBLIC_ prefix). Leaving it blank disables the feature:
# /api/bug-report answers 503 and the form shows a generic error. Set it in
# Vercel for prod.
GITHUB_BUG_REPORT_TOKEN=

# Event bot (#events channel) — polls the ScrapedDuck feed for new raid events
# and raid-boss rotations, then posts them as the bot.
#
# POGO_BOT_USER_ID is the auth-user UUID of the bot account. Create it once per
# Supabase project (Authentication → Add user), then insert a profiles row with
# is_bot = true — see docs/plans/pogo-event-bot.md. Prod and preview have
# DIFFERENT bot users, so this differs per environment.
#
# POGO_CRON_SECRET gates POST /api/cron/pogo-feed. The same value must be set as
# a GitHub repo secret (with POGO_CRON_URL) so the scheduled workflow can call
# it. Any long random string: `openssl rand -hex 32`.
#
# Both are server-only secrets (no NEXT_PUBLIC_). Leaving either blank disables
# the feature: the route answers 503 and nothing is posted.
POGO_BOT_USER_ID=
POGO_CRON_SECRET=

# Q&A bot ("!pogo <spørgsmål>" in #generelt / #events) — answers members'
# Pokémon GO questions via the Anthropic API, posting as the same bot account as
# POGO_BOT_USER_ID above.
#
# This is the project's only METERED credential: every answer costs real money
# (roughly 1-6 øre, depending on whether it needs a web search). Set a monthly
# spend limit in the Anthropic Console — the per-user and global caps in
# src/lib/pogo-qa/types.ts are the first line of defence, but the Console limit
# is the one that survives a bug in them.
#
# GDPR: this key sends member-written question text to Anthropic in the US.
# Accept the DPA in the Console before using it in production, and see §16 of
# the Privacy Policy for what members are told. Create the key at
# console.anthropic.com → Settings → API keys.
#
# Server-only secret (no NEXT_PUBLIC_). Leaving it blank disables the feature:
# /api/bot/ask answers 503, no question is ever sent anywhere, and the rest of
# chat is unaffected.
ANTHROPIC_API_KEY=
